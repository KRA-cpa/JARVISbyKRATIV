# Files uploaded by `gcloud run deploy --source .` (Cloud Build). Without this file gcloud falls back to .gitignore,
# which excludes /build - the image needs it. Upload only what the Dockerfile copies.
**
!Dockerfile
!server/
!server/**
!api/
!api/_lib/
!api/_lib/**
!build/
!build/**
!scripts/
!scripts/gen-ddl.js
!scripts/db-load-sheets.js
!scripts/db-migrate.js
!scripts/db/
!scripts/db/ddl-rules.js
!scripts/lib/
!scripts/lib/sheetsExport.js
!scripts/lib/sheetsSync.js
!scripts/lib/syncRun.js
!scripts/lib/companyScope.js
# Never upload these even if a negation above matches
**/.env*
**/node_modules/
