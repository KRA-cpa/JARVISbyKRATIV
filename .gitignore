# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
# Personal Windows shortcuts (kept on disk, not tracked)
AdminCMD.bat
runCMD.lnk
.env.local
.env.development.local
.env.test.local
.env.production.local
# Any other local env file (e.g. .env.firebase.local for importing into Vercel)
.env*.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development logs
logs/
*.log
dev-*.log
proxy-*.log
api-*.log

# Claude conversation backups
.claude/conversation-backups/latest/
.claude/conversation-backups/backup-password.txt
.claude/checkpoints/
!.claude/conversation-backups/encrypted/
!.claude/conversation-backups/backup-index.json

# Claude Code local settings (per-machine permissions + SessionStart hook — see REF_SessionLog.md §4)
.claude/settings.local.json

# Firebase CLI deploy cache (firebase deploy --only hosting)
.firebase/

# Sheets exports + load reports (migration 0.8) hold company data - never in the repo
daloy-export-*.json
*.load-report.json
*.load-report.txt
