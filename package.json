{
  "name": "jarvisbyerp",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@firebase/analytics": "^0.10.16",
    "@mui/icons-material": "^7.1.1",
    "@mui/material": "^7.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "firebase": "^11.9.0",
    "jose": "^5.9.6",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.1",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.17",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:ci": "node scripts/build-ci.js",
    "test:server": "node scripts/test-cloudrun-server.js",
    "db:gen-ddl": "node scripts/gen-ddl.js",
    "check:ddl": "node scripts/gen-ddl.js --check && node scripts/test-gen-ddl.js",
    "db:migrate": "node scripts/db-migrate.js",
    "test:db-migrate": "node scripts/test-db-migrate.js",
    "db:load-sheets": "node scripts/db-load-sheets.js",
    "test:db-load-sheets": "node scripts/test-db-load-sheets.js",
    "db:explain": "node scripts/db-explain.js",
    "test:db-explain": "node scripts/test-db-explain.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:setup": "node scripts/setup-tests.js",
    "test:unit": "node scripts/test-runner.js --suite=unit",
    "test:integration": "node scripts/test-runner.js --suite=integration",
    "test:hooks": "node scripts/test-runner.js --suite=hooks",
    "test:api": "node scripts/test-runner.js --suite=api",
    "test:all": "node scripts/test-runner.js",
    "test:coverage": "npm test -- --coverage --watchAll=false",
    "test:ci": "node scripts/test-runner.js --ci",
    "test:watch": "npm test -- --watch",
    "test:debug": "node --inspect-brk scripts/test-runner.js",
    "test:api-endpoints": "node scripts/test-api.js",
    "test:api-health": "node scripts/test-api.js --health",
    "check:api-contract": "node scripts/check-api-contract.js",
    "check:code-rules": "node scripts/check-code-rules.js --self-test && node scripts/check-code-rules.js"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "http-proxy-middleware": "^3.0.5",
    "postcss": "^8.5.4"
  }
